# ============================================================
#  内网流量智能检测系统 —— 环境变量示例（复制为 .env 后按需修改）
#  用法：cp .env.example .env && docker compose up -d --build
# ============================================================

# ---------- 宿主机对外端口（避免与已有服务冲突，可按需调整） ----------
FRONTEND_PORT=8085
BACKEND_PORT=8082
MYSQL_PORT=3306
REDIS_PORT=6380
ES_PORT=9200
INFER_PORT=8000
KAFKA_EXTERNAL_PORT=9094

# ---------- MySQL ----------
# 必填：MySQL root 密码（同时作为后端 DB_PASSWORD 使用）
MYSQL_ROOT_PASSWORD=change-me
# 数据库名（默认 traffic_platform，需与 DB_URL 一致）
MYSQL_DATABASE=traffic_platform

# ---------- 后端数据库连接 ----------
# 可选，默认使用 compose 内部的 mysql 服务名（注意保留引号，含 & 特殊字符）
DB_URL="jdbc:mysql://mysql:3306/traffic_platform?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai"
DB_USERNAME=root

# ---------- 认证 ----------
# 必填：JWT 令牌密钥（生产环境务必改为强随机串）
JWT_SECRET=change-me-to-a-long-random-string
# Druid 监控台账号密码
DRUID_USERNAME=admin
DRUID_PASSWORD=admin123

# ---------- Kafka / 推理 ----------
# 输入/输出主题名
TRAFFIC_TOPIC=traffic
RESULT_TOPIC=traffic_results
# 推理服务 CORS（单机部署默认 * ；生产建议改为前端地址，如 http://<host>）
CORS_ALLOW_ORIGINS="*"