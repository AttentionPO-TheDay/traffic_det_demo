<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.xt.mapper.XtPcapMapper">

    <resultMap type="XtPcap" id="XtPcapResult">
        <result property="name" column="name"/>
        <result property="size" column="size"/>
        <result property="timestamp" column="timestamp"/>
    </resultMap>

    <sql id="selectXtPcapVo">
        select name, size, timestamp
        from xt_pcap
    </sql>

    <select id="selectXtPcapList" resultMap="XtPcapResult">
        <include refid="selectXtPcapVo"/>
    </select>

    <insert id="insertXtPcap" parameterType="XtPcap">
        insert into xt_pcap
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null">name,</if>
            <if test="size != null">size,</if>
            <if test="timestamp != null">timestamp,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null">#{name},</if>
            <if test="size != null">#{size},</if>
            <if test="timestamp != null">#{timestamp},</if>
        </trim>
    </insert>

</mapper>